# Copia este archivo a .env.local y rellena los valores.
# .env* está en .gitignore — nunca commitear secrets.

# === Requeridas ===

# Endpoint GraphQL de WordPress (server-only, sin prefijo NEXT_PUBLIC_).
# El endpoint NO debe entrar al bundle del cliente.
WORDPRESS_API_URL=https://YOUR-WP-INSTANCE.example.com/graphql

# Token compartido entre Next y WP para el webhook de revalidación on-demand.
# Generar con:  openssl rand -base64 32
# Usa valores DIFERENTES por entorno (dev, staging, prod).
REVALIDATE_SECRET=replace-me-with-a-long-random-string

# === Recomendadas ===

# Dominio canónico del sitio. Usado por metadataBase, sitemap, robots,
# breadcrumbs JSON-LD y share-box. Si vacío, default = https://labden.com.mx.
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# Google Tag Manager. Si vacío, no se inyecta GTM (recomendado en dev/staging).
NEXT_PUBLIC_GTM_ID=

# === Opcionales (CI/testing) ===

# Slug del post de blog usado por playwright-seo.spec.ts.
# Solo necesario si el default ('organizacion-flujo-trabajo-laboratorio-dental')
# no existe en tu instancia de WP.
# BLOG_TEST_SLUG=
